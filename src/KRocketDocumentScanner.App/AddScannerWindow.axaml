<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KRocketDocumentScanner.App"
        xmlns:s="clr-namespace:KRocketDocumentScanner.App.ViewModels.Localization;assembly=KRocketDocumentScanner.App.ViewModels"
        x:Class="KRocketDocumentScanner.App.AddScannerWindow"
        Title="{x:Static s:Strings.AddScannerTitle}"
        WindowDecorations="{x:Static local:AppOptions.WindowDecorations}"
        CanResize="False"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner">

  <Border BorderThickness="{x:Static local:AppOptions.WindowBorderThickness}"
          BorderBrush="{DynamicResource ThemeBorderStrongBrush}">
  <DockPanel>

    <!-- Fixed-size utility dialog: close only, same treatment as ManageScannersWindow. -->
    <Border Name="HeaderBorder" DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeBorderBrush}"
            Background="Transparent"
            IsVisible="{x:Static local:AppOptions.ShowCustomChrome}"
            PointerPressed="OnToolbarPointerPressed">
      <Grid>
        <TextBlock Text="{Binding $parent[Window].Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
        <Button Classes="chrome chrome-close" Content="×" ToolTip.Tip="{x:Static s:Strings.CloseTooltip}"
                Click="OnCloseWindow" HorizontalAlignment="Right" />
      </Grid>
    </Border>

    <DockPanel Margin="20">

    <TabControl>

      <TabItem Header="{x:Static s:Strings.DiscoverTab}">
        <DockPanel Margin="0,12,0,0">
          <!-- Each tab has its own error line, so one tab's failure never shows on the other. -->
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                     IsVisible="{Binding HasStatusMessage}" Foreground="{DynamicResource ThemeDangerBrush}"
                     TextWrapping="Wrap" Margin="0,12,0,0" />

          <!-- Searching replaces the heading/button/results entirely with a centered
               indicator while active, rather than a small inline line above an empty list. -->
          <Grid>
            <StackPanel IsVisible="{Binding IsSearching}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
              <ProgressBar IsIndeterminate="True" Width="160" HorizontalAlignment="Center" />
              <TextBlock Text="{x:Static s:Strings.SearchingText}" Opacity="0.75" HorizontalAlignment="Center" />
            </StackPanel>

            <DockPanel IsVisible="{Binding !IsSearching}">
              <!-- One footer button adds every checked card at once, instead of each card
                   having its own Add — pinned bottom-right like the Manual entry tab's. -->
              <Button DockPanel.Dock="Bottom" Content="{x:Static s:Strings.AddScannerActionButton}"
                      Command="{Binding AddSelectedCommand}" Classes="accent"
                      HorizontalAlignment="Right" Margin="0,12,0,0" />

              <!-- The discover/refresh action lives aligned with the "Discovered List" heading
                   it acts on, not up in the window's own title bar. -->
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBlock Grid.Column="0" Text="{x:Static s:Strings.DiscoveredListHeading}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="⟳" FontSize="16"
                        Command="{Binding DiscoverCommand}" Classes="linklike"
                        ToolTip.Tip="{x:Static s:Strings.SearchForScannersButton}" />
              </Grid>

              <TextBlock DockPanel.Dock="Top" IsVisible="{Binding ShowNoResultsMessage}"
                         TextWrapping="Wrap" Opacity="0.75" FontSize="13"
                         Text="{x:Static s:Strings.NoScannersFoundText}" />

              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Found}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- One compact row per physical device: checkbox (checked by default —
                           see ScannerGroupViewModel.IsChecked), status dot, name, then a
                           connection picker only when there's more than one to choose
                           between. No per-row Add anymore — the footer button adds every
                           checked row at once. -->
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,4">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Margin="0,0,4,0" />
                        <!-- A plain device icon, not a status dot — nothing here has actually
                             been reachability-checked yet (that only happens once a scanner
                             is saved; see ManageScannersWindow), so a colored "ready" dot
                             would be a claim this list can't back up. -->
                        <TextBlock Grid.Column="1" Text="⎙" FontSize="14" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox Grid.Column="3" IsVisible="{Binding HasMultipleConnections}"
                                  ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}"
                                  Margin="10,0,0,0">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding DisplayText}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="{x:Static s:Strings.ManualEntryTab}">
        <!-- Add is pinned bottom-right, with the fields kept up top — not immediately
             following them — matching the spacious form layout in the mock. -->
        <DockPanel Margin="0,16,0,0">
          <Button DockPanel.Dock="Bottom" Content="{x:Static s:Strings.AddScannerActionButton}"
                  Command="{Binding AddManualCommand}" Classes="accent" HorizontalAlignment="Right" />

          <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding IsAddingManual}" Spacing="6" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Text="{x:Static s:Strings.CheckingScannerStatus}" Opacity="0.75" FontSize="12" />
          </StackPanel>

          <TextBlock DockPanel.Dock="Bottom" Text="{Binding ManualStatusMessage}"
                     IsVisible="{Binding HasManualStatusMessage}" Foreground="{DynamicResource ThemeDangerBrush}"
                     TextWrapping="Wrap" Margin="0,0,0,10" />

          <StackPanel Spacing="14">

            <StackPanel Spacing="5">
              <TextBlock Text="{x:Static s:Strings.AddressLabel}" FontSize="13" />
              <TextBox Text="{Binding ManualAddress}" Watermark="{x:Static s:Strings.AddressWatermark}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </TabItem>

    </TabControl>
    </DockPanel>
  </DockPanel>
  </Border>
</Window>
