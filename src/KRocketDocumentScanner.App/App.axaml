<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KRocketDocumentScanner.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Assets/AppBanner.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadiusSm}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtleBrush}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadiusSm}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadiusSm}" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeBorderStrongBrush}" />
    </Style>
    <Style Selector="Button.chrome-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeDangerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}" />
    </Style>

    <Style Selector="Button.linklike">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadiusSm}" />
    </Style>
    <Style Selector="Button.linklike:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeBorderStrongBrush}" />
    </Style>

    <Style Selector="Button.panelheader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
      <Setter Property="Padding" Value="12,14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
  </Application.Styles>
</Application>
